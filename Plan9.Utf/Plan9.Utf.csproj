<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Plan9.Utf</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Scott J Guyton</Authors>
    <Description>9front's UTF-8: libc's rune and utf functions, and a System.Text.Encoding that reads and writes text as Plan 9 does.</Description>
    <PackageTags>plan9;9front;utf-8;rune;encoding</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Plan9.Utf.Tests" />
  </ItemGroup>

</Project>
